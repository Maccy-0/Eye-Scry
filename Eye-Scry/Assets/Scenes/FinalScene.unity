  m_Script: {fileID: 11500000, guid: fcaff77acacc731448348d4c86e0721d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogLogic
  textMesh: {fileID: 1700683249}
  introduction:
  - Hello there,
  - I need some assistance...
  - You see I have misplaced some things around my wizard tower,
  - and I am much too busy to be looking for them myself.
  - Do you think you could assist me?
  - I am currently missing three (3) things.
  - My magic wand, my cursed ring, and my old grimoire.
  - Please be quick, I don't have much time on my hands.
  - I'll wait here if you need any help looking for them.
  farewell:
  - Oh you found all of my things?
  - Great, where are they?
  - Ahh.. I see. Thank you so much.
  - 'I need to go now, '
  - ' it seems while we were talking someone got into my tower.'
  - they made a wreck of my things and burnt down my fathers portrait!
  - Thanks again, I'll be seeing you around!
  hintController: {fileID: 667850152}
  hintBegin: {fileID: 667850151}
  canvasBegin: {fileID: 2124604303}
  hintPanel: {fileID: 448068063}
